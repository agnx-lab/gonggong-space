   "lines": [
    {
     "id": "f14a",
     "voice": "N",
     "text": "现在就试试：打开网址，飞书登录，添加机器，招一个 Bot，进群艾特它。",
     "local": 0.7,
     "start": 178.65,
     "dur": 6.5
    },
    {
     "id": "f14b",
     "voice": "N",
     "text": "遇到问题，就在 AI 群里说一声。",
     "local": 7.58,
     "start": 185.53,
     "dur": 2.7
    },
    {
     "id": "f14c",
     "voice": "G",
     "text": "我在群里等你！",
     "local": 10.91,
     "start": 188.86,
     "dur": 1.869
    },
    {
     "id": "f14d",
     "voice": "N",
     "text": "共工空间。让 AI 同事，在群里一起干活。",
     "local": 13.16,
     "start": 191.11,
     "dur": 3.8
    }
   ]
  }
 ]
}